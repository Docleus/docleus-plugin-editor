{
  "name": "@docleus/plugin-editor",
  "version": "0.0.7",
  "private": true,
  "type": "module",
  "description": "The Docleus block editor: Tiptap shell, toolbar, slash menu, block settings, and the editor API for block plugins.",
  "license": "MIT",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    "./editor": "./dist/editor/index.js",
    "./docleus.plugin.json": "./docleus.plugin.json"
  },
  "files": [
    "dist",
    "docleus.plugin.json"
  ],
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc -b tsconfig.json",
    "lint": "oxlint -c node_modules/@docleus/config/oxlintrc.json src tests",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deps": "depcruise src --config dependency-cruiser.cjs",
    "license": "license-checker-rseidelsohn --summary --onlyAllow \"MIT;Apache-2.0;BSD-2-Clause;BSD-3-Clause;ISC;0BSD;BlueOak-1.0.0;CC0-1.0;Python-2.0;CC-BY-3.0;(MIT AND CC-BY-3.0)\" --excludePrivatePackages --excludePackages \"lightningcss@1.33.0\"",
    "test": "vitest run",
    "e2e": "playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm deps && pnpm license && pnpm test"
  },
  "peerDependencies": {
    "@docleus/sdk": ">=0.0.1 <0.0.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "dependencies": {
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-bold": "3.32.0",
    "@tiptap/extension-code": "3.32.0",
    "@tiptap/extension-collaboration": "3.32.0",
    "@tiptap/extension-collaboration-caret": "3.32.0",
    "@tiptap/extension-document": "3.32.0",
    "@tiptap/extension-italic": "3.32.0",
    "@tiptap/extension-link": "3.32.0",
    "@tiptap/extension-paragraph": "3.32.0",
    "@tiptap/extension-strike": "3.32.0",
    "@tiptap/extension-text": "3.32.0",
    "@tiptap/extensions": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/y-tiptap": "3.0.10",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@docleus/config": "link:../docleus-core/packages/config",
    "@docleus/kernel": "link:../docleus-core/packages/kernel",
    "@docleus/sdk": "link:../docleus-core/packages/sdk",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "dependency-cruiser": "18.7.0",
    "happy-dom": "21.0.4",
    "license-checker-rseidelsohn": "5.0.1",
    "oxlint": "1.89.0",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "y-protocols": "1.0.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Docleus/docleus-plugin-editor.git"
  },
  "bugs": {
    "url": "https://github.com/Docleus/docleus-plugin-editor/issues"
  },
  "homepage": "https://github.com/Docleus/docleus-plugin-editor#readme"
}
